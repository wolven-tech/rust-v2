# Copy to fly.app.toml, replace app name, and keep product-specific Fly state
# out of rust-v2 when creating a new bet.
app = "replace-with-product-app"
primary_region = "lhr"

[build]
  dockerfile = "deploy/static.Dockerfile"
  [build.args]
    BUNDLE = ".fly-artifacts/app"
    NGINX_CONFIG = "deploy/nginx.spa.conf"

[http_service]
  internal_port = 8080
  force_https = true
  # The product shell may wake on an uncached request. Keep a warm floor only
  # after measuring that resume latency harms the bet's value circuit.
  auto_stop_machines = "suspend"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

  [[http_service.checks]]
    grace_period = "2s"
    interval = "15s"
    method = "GET"
    timeout = "2s"
    path = "/health"

[[vm]]
  memory = "256mb"
  cpu_kind = "shared"
  cpus = 1
