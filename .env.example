# Copy to `.env` and source it before `meta dev`.
#
# Every variable here is server-side only. Unlike the browser-exposed anon key
# rust-v1 shipped in its Next.js bundle, no AllSource credential ever reaches a
# browser (§7 item 18).

# ── AllSource (REQUIRED — no defaults, see R6) ───────────────────────────────
# There is deliberately no fallback for these two. Three upstream sources give
# three different port pairs (:3900/:3902, :3280/:3283, :3854/:3855), so a
# default would be a guess that fails confusingly.
ALLSOURCE_CORE_URL=http://localhost:3900
# Points at Core on purpose: `QueryClient` calls Core's own
# /api/v1/events/query, so a single-node dev stack needs no Query Service.
# Change to http://localhost:3902 when you run one (`docker compose --profile
# gateway up`).
ALLSOURCE_QUERY_URL=http://localhost:3900
# Core in ALLSOURCE_DEV_MODE ignores the value, but the SDK rejects an empty
# key at construction, so it still has to be set. Production keys look like
# `ask_…`.
ALLSOURCE_API_KEY=dev

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-key-that-is-at-least-32-characters-long
# MUST include the /auth segment: the OAuth plugin appends only
# /callback/{provider} (§5.4).
AUTH_BASE_URL=http://localhost:4400/auth

# Google OAuth. Both or neither — a half-configured pair is rejected at boot.
# NOTE: the OAuth plugin is not wired in this scaffold; see the SEAM comment in
# apps/api/src/infrastructure/auth/better.rs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── HTTP ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4400
# Explicit list, never `*` — that is illegal alongside
# Access-Control-Allow-Credentials: true, and every request carries the session
# cookie (D17). `*` is rejected at boot.
CORS_ORIGINS=http://localhost:4401,http://localhost:4402

# How many x-forwarded-for entries on the RIGHT your own infrastructure appends.
#
# 0 — the default — means "no trusted proxy", and the header is then ignored
# entirely: the rate limiter keys on the socket address, which a client cannot
# forge. Set it to the real number BEFORE deploying behind a proxy, or every
# request buckets under the proxy's own ip.
#
# Do not raise it speculatively. Trusting a hop that does not exist lets a caller
# choose their own bucket by sending a fake entry, which both bypasses the limit
# and grows its in-memory key set without bound.
TRUSTED_PROXY_HOPS=0

# ── Frontend (compile-time, baked into the wasm bundle) ──────────────────────
PUBLIC_API_URL=http://localhost:4400

RUST_LOG=info,api=debug
# `json` emits one JSON object per event, so an aggregator indexes the fields
# the code already attaches rather than re-parsing a line. Anything else stays
# human-readable. The Dockerfile sets json; local development does not.
# LOG_FORMAT=json

# ── Metrics (optional) ───────────────────────────────────────────────────────
# Unset means NO recorder is installed and every metrics macro in the workspace
# is a no-op, so this costs nothing when it is off.
#
# A SEPARATE PORT, deliberately: scrape output names every route and reports
# request volumes, and it has no business being subject to — or exempt from —
# the application's rate limiter and CORS policy. Do not publish this port
# outside your network. The Dockerfile does not EXPOSE it.
#
# A value that will not bind fails the boot on purpose: a metrics endpoint that
# silently is not there is how a dashboard shows a flat line everyone reads as
# "no traffic".
# METRICS_ADDR=0.0.0.0:9090

# ── Traces (optional) ────────────────────────────────────────────────────────
# The OpenTelemetry spec's own variable name, not one invented here — a sidecar
# collector often injects it for you. Unset means no exporter and no batching
# task. `/v1/traces` is appended; give the collector's base URL.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Product analytics (optional) ─────────────────────────────────────────────
# Unset means analytics is DISABLED, not broken: events are logged instead of
# sent. A missing key must never fail a request that would otherwise succeed.
# POSTHOG_API_KEY=phc_…
# Only for self-hosted or EU-resident projects; the SDK defaults to US.
# POSTHOG_HOST=https://eu.posthog.com

# ── Transactional email (optional) ───────────────────────────────────────────
# Unset means email RENDERS TO THE LOG rather than sending, so a broken template
# surfaces in development instead of the first time a key exists in staging.
# RESEND_API_KEY=re_…
EMAIL_FROM=onboarding@example.com
