root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# rustfmt owns .rs; this is here so an editor without a rustfmt integration does
# not fight it.
[*.rs]
max_line_length = 100

[*.{toml,yml,yaml,json,md,css,html}]
indent_size = 2

# Trailing whitespace is significant in Markdown (two spaces = line break).
[*.md]
trim_trailing_whitespace = false
